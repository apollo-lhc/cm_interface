{
  "device": "Firefly 4-channel transceiver (ECUO-B04 / ECUE-B04)",
  "description": "4-channel Firefly optical/copper transceiver module",
  "datasheet": "Firefly Manual ECUO 25G_28G x4 Revision_1.0.pdf",
  "channel_count": 4,
  "uart_address_range": "0x20-0x3F (I2C/SMBus lower page)",
  "interface": "Two-Wire Interface (TWI/I2C) with interrupt (Int_L)",
  "lower_page_registers": {
    "STATUS": {"addr": "0x02", "size": 1, "access": "RO", "bits": {"7-2": "Reserved", "1": "Int_L Status", "0": "Data_Not_Ready"}},
    "STATUS_SUMMARY": {"addr": "0x06", "size": 1, "access": "RO", "bits": {"7-6": "Reserved", "5": "Fault Summary", "4-2": "Reserved", "1": "Module Alarm Summary", "0": "Init Complete"}},
    "TX_FAULT_LATCH": {"addr": "0x09", "size": 1, "access": "RO", "description": "Latched TX fault flags (4 channels, bits 0-3)"},
    "TEMP_ALARM_LATCH": {"addr": "0x11", "size": 1, "access": "RO", "bits": {"7": "Temp High", "6": "Temp Low", "5-0": "Reserved"}},
    "VCC_ALARM_LATCH": {"addr": "0x12", "size": 1, "access": "RO", "bits": {"7": "VCC High", "6": "VCC Low", "5-0": "Reserved"}},
    "TEMP_MONITOR": {"addr": "0x16", "size": 1, "access": "RO", "description": "Internal temperature, signed 8-bit (°C), accuracy ±3°C"},
    "VCC_MONITOR": {"addr": "0x1A", "size": 2, "access": "RO", "description": "Supply voltage, 16-bit unsigned (100 µV LSB), range 0-6.55V"},
    "ELAPSED_TIME": {"addr": "0x26", "size": 2, "access": "RO", "description": "Operating time, 16-bit unsigned (2 hours LSB)"},
    "RESET": {"addr": "0x33", "size": 1, "access": "WO", "description": "Reset all registers (write 0x01)"},
    "TX_DISABLE": {"addr": "0x34", "size": 1, "access": "RW", "description": "Per-channel TX disable (bits 0-3 for CH0-CH3)"},
    "TX_POLARITY_INV": {"addr": "0x3A", "size": 1, "access": "RW", "description": "Per-channel TX polarity invert (bits 0-3)"},
    "RX_DISABLE": {"addr": "0x36", "size": 1, "access": "RW", "description": "Per-channel RX disable (bits 0-3)"},
    "RX_OUTPUT_DISABLE": {"addr": "0x38", "size": 1, "access": "RW", "description": "Per-channel RX output disable (bits 0-3)"},
    "RX_OUTPUT_AMP": {"addr": "0x3E", "size": 1, "access": "RW", "description": "RX output amplitude (global for 4 channels, 0-7 range)"},
    "RX_DEEMPHASIS": {"addr": "0x4D", "size": 1, "access": "RW", "description": "RX de-emphasis (global for 4 channels, 0-15 range)"},
    "TX_FAULT_MASK": {"addr": "0x61", "size": 1, "access": "RW", "description": "Mask TX fault interrupts (bits 0-3)"},
    "TEMP_ALARM_MASK": {"addr": "0x69", "size": 1, "access": "RW", "description": "Mask temperature alarms"},
    "VCC_ALARM_MASK": {"addr": "0x6A", "size": 1, "access": "RW", "description": "Mask VCC alarms"},
    "RX_LOS_LATCH": {"addr": "0x07", "size": 1, "access": "RO", "description": "Latched RX Loss of Signal (4 channels, bits 0-3)"},
    "RX_LOS_MASK": {"addr": "0x5F", "size": 1, "access": "RW", "description": "Mask RX LOS interrupts (bits 0-3)"},
    "FIRMWARE_VER": {"addr": "0x6F", "size": 3, "access": "RO", "description": "Firmware version"},
    "EEPROM_REV": {"addr": "0x6E", "size": 1, "access": "RO", "description": "EEPROM revision"},
    "PAGE_SELECT": {"addr": "0x7F", "size": 1, "access": "RW", "description": "Upper page selector (0x00-0x0B)"}
  },
  "upper_pages": {
    "0x00": {
      "description": "Vendor ID and capabilities",
      "MAX_TEMP": {"addr": "0x84", "size": 1, "access": "RO", "description": "Max recommended case temp (°C, default 70°C)"},
      "VENDOR_NAME": {"addr": "0x98", "size": 10, "access": "RO", "description": "Vendor name ('Samtec Inc')"},
      "VENDOR_PN": {"addr": "0xAB", "size": 16, "access": "RO", "description": "Part number"},
      "VENDOR_SN": {"addr": "0xBD", "size": 10, "access": "RO", "description": "Serial number"}
    },
    "0x01": {
      "description": "Alarm thresholds",
      "TEMP_HIGH_THRESH": {"addr": "0x80", "size": 1, "access": "RO", "description": "Temp high alarm (°C, default 80°C)"},
      "TEMP_LOW_THRESH": {"addr": "0x82", "size": 1, "access": "RO", "description": "Temp low alarm (°C, default 0°C)"},
      "VCC_HIGH_THRESH": {"addr": "0x90", "size": 2, "access": "RO", "description": "VCC high alarm (default 3.465V)"},
      "VCC_LOW_THRESH": {"addr": "0x92", "size": 2, "access": "RO", "description": "VCC low alarm (default 3.135V)"}
    },
    "0x02": {
      "TWI_ADDRESS": {"addr": "0xFF", "size": 1, "access": "RW", "description": "I2C address (non-volatile, default 0xA0)"}
    },
    "0x0B": {
      "TEMP_BIN_BASE": {"addr": "0x80", "size": 60, "access": "RO", "description": "Time-at-temperature bins (20 bins × 3 bytes)"},
      "PEAK_TEMP": {"addr": "0xC2", "size": 1, "access": "RO", "description": "Peak recorded temperature (°C)"}
    }
  },
  "tx_output_amplitude_table": {
    "0x0": "300 mV (default)",
    "0x1": "450 mV",
    "0x2": "600 mV",
    "0x3": "900 mV",
    "0x4-0xF": "Reserved"
  },
  "rx_deemphasis_table": {
    "0x0": "No equalization (default)",
    "0x1": "1 dB",
    "0x2": "2 dB",
    "0x3": "3 dB",
    "0x4": "4 dB",
    "0x5": "5 dB",
    "0x6": "6 dB",
    "0x7": "7.5 dB",
    "0x8-0xF": "Reserved"
  },
  "notes": [
    "Memory map based on InfiniBand CXP Interface Specification",
    "All multi-byte values are Big Endian",
    "Lower page 0x00-0x7F always directly accessible",
    "Upper pages selected via PAGE_SELECT at 0x7F",
    "4-channel devices use packed register fields (1 byte vs 2 bytes for 12-channel)",
    "Data rates: 10G/14G/25G/28G per channel depending on model"
  ]
}